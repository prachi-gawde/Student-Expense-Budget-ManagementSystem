@model WebNetProject386.Models.Expense

@{
ViewData["Title"] = "Delete Expense";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger">
                <div class="card-body p-4">
                    <h2 class="text-danger mb-2">Delete Expense</h2>
                    <p class="text-muted">
                        Are you sure you want to delete this expense?
                    </p>

```
                <div class="bg-light rounded p-3 mb-4">
                    <p><strong>Title:</strong> @Model.Title</p>
                    <p><strong>Category:</strong> @Model.Category</p>
                    <p><strong>Amount:</strong> @Model.Amount.ToString("C", new System.Globalization.CultureInfo("en-IN"))</p>
                    <p class="mb-0">
                        <strong>Date:</strong> @Model.ExpenseDate.ToString("dd MMM yyyy")
                    </p>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger">
                        Yes, Delete
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
```

</div>
