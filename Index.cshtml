@model IEnumerable<WebNetProject386.Models.Expense>

@{
ViewData["Title"] = "Expense Dashboard";
decimal totalExpenses = Model.Sum(e => e.Amount);
}

<style>
    .dashboard {
        padding: 25px 0;
    }

    .hero {
        background: linear-gradient(135deg, #243b55, #141e30);
        color: white;
        padding: 30px;
        border-radius: 18px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff;
        border-radius: 15px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.07);
        margin-bottom: 25px;
    }

    .amount {
        font-size: 30px;
        font-weight: 700;
        color: #243b55;
    }

    .expense-table {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }

    .btn-add {
        background: #ffffff;
        color: #243b55;
        font-weight: 600;
        border-radius: 9px;
        padding: 10px 18px;
        text-decoration: none;
    }

    .category-badge {
        background: #e8eef7;
        color: #243b55;
        padding: 6px 10px;
        border-radius: 20px;
    }
</style>

<div class="dashboard">
    <div class="hero">
        <h1>💰 Expense Dashboard</h1>
        <p>Track your spending and manage your student budget.</p>

```
    <a asp-action="Create" class="btn-add">
        + Add New Expense
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6 col-lg-4">
        <div class="summary-card">
            <h5>Total Expenses</h5>
            <div class="amount">₹@totalExpenses.ToString("N2")</div>
            <p class="text-muted mb-0">All recorded expenses</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="summary-card">
            <h5>Number of Records</h5>
            <div class="amount">@Model.Count()</div>
            <p class="text-muted mb-0">Expenses recorded</p>
        </div>
    </div>
</div>

<div class="expense-table">
    <h4 class="mb-3">Recent Expenses</h4>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h5>No expenses recorded yet.</h5>
            <p class="text-muted">Add your first expense to get started.</p>
            <a asp-action="Create" class="btn btn-primary">
                Add Expense
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model)
                    {
                        <tr>
                            <td>
                                <strong>@expense.Title</strong>
                            </td>
                            <td>
                                <span class="category-badge">
                                    @expense.Category
                                </span>
                            </td>
                            <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-bold">
                                ₹@expense.Amount.ToString("N2")
                            </td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@expense.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@expense.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
```

</div>
